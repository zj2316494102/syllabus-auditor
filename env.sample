# syllabus-auditor 环境变量示例
# 复制为 .env 后填写实际值：cp env.sample .env  （Windows: copy env.sample .env）

# -----------------------------------------------------------------------------
# PostgreSQL（必需）
# -----------------------------------------------------------------------------
POSTGRES_ADDRESS=localhost:5432
POSTGRES_DB=course
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# -----------------------------------------------------------------------------
# LLM（direct_llm 审核维度需要；profile 定义见根目录 project.yaml，密钥填 .env）
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# OpenAI 兼容接口（如 Qwen、DeepSeek 等）
LLM_BASE_URL=
LLM_API_KEY=EMPTY
LLM_MODEL_NAME=deepseek-v4-flash

# DeepSeek V4 Pro 备用配置（需要切回 Pro 时，把 LLM_MODEL_NAME 改为此值）
DS_PRO_BASE_URL=https://api.deepseek.com
DS_PRO_API_KEY=
DS_PRO_MODEL_NAME=deepseek-v4-pro



# -----------------------------------------------------------------------------
# 可选：应用行为
# -----------------------------------------------------------------------------
# LOG_LEVEL=INFO
